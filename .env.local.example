NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx_or_legacy_jwt_anon_key

# Shared secret between this site and the Mac POS.
# The POS sends it as `x-revalidate-secret` header on POST /api/revalidate.
# Generate with: openssl rand -hex 32
REVALIDATE_SECRET=replace_with_a_long_random_string

# ---------------- Stripe ----------------
# Public key — safe to ship to the browser. Used only by future client SDK
# upgrades; the current hosted-Checkout flow does not require it, but we
# keep it set so it's already in place.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Secret key — server only. Backs /api/checkout/session.
STRIPE_SECRET_KEY=sk_test_xxx

# Webhook signing secret — server only. Verifies POST /api/webhooks/stripe
# was actually sent by Stripe. Get one per endpoint from Dashboard →
# Developers → Webhooks → (your endpoint) → Signing secret. For local
# `stripe listen` it prints a separate whsec_… on first run.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Supabase service-role key — server only, never expose to the browser.
# Used exclusively by the Stripe webhook to bypass RLS when marking
# orders paid (the request comes from Stripe, not the user).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
